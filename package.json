{
  "name": "cosmion",
  "version": "0.1.1",
  "description": "Generate images with any OpenRouter model from your terminal or your agent, with your own key.",
  "keywords": [
    "openrouter",
    "image-generation",
    "cli",
    "ai",
    "agents"
  ],
  "license": "MIT",
  "author": "Kyle Neal",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/neal-kyle/cosmion.git"
  },
  "type": "module",
  "bin": {
    "cosmion": "dist/cli/main.js",
    "csn": "dist/cli/main.js"
  },
  "files": [
    "dist",
    "SKILL.md"
  ],
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "prepack": "npm run build",
    "pretest": "npm run build",
    "test": "vitest run",
    "lint": "biome check . && tsc --noEmit",
    "format": "biome format --write .",
    "pack-check": "node --experimental-strip-types scripts/pack-check.mjs"
  },
  "dependencies": {
    "commander": "^15.0.0",
    "csv-parse": "^7.0.3",
    "env-paths": "^4.0.0",
    "image-size": "^2.0.4",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "@types/node": "^22.20.5",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}
